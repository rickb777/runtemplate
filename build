#!/bin/bash -e
cd $(dirname $0)

PATH=$HOME/go/bin:$PATH
unset GOPATH
export GO111MODULE=on

go mod download

echo
echo App Testing...
go test ./app/...

echo
echo Installing...
go install .

type runtemplate

echo
echo Go Fmt...
gofmt -l -w *.go app/*.go

echo
echo Template Testing...
go clean -testcache
RACE=
[ "$CGO_ENABLED" != "1" ] || RACE=-race
go test $RACE ./...

echo
echo Code vetting...
go vet ./...

echo ok.
